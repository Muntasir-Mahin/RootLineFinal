# OPTIONAL: public contact overrides, not secrets.
# These five values are built in already; no .env file or PyCharm setup is needed.
ROOTLINE_CONTACT_BUSINESS_NAME=RootLine
ROOTLINE_CONTACT_PHONE=+8801923194036
ROOTLINE_CONTACT_WHATSAPP=+8801923194036
ROOTLINE_CONTACT_EMAIL=rootlineuap@gmail.com
ROOTLINE_CONTACT_LANGUAGES="Bangla, English"
# Optional fields intentionally left empty, as requested.
ROOTLINE_CONTACT_FACEBOOK=
ROOTLINE_CONTACT_MESSENGER=
ROOTLINE_CONTACT_INSTAGRAM=
ROOTLINE_CONTACT_YOUTUBE=
ROOTLINE_CONTACT_SOCIALS=
ROOTLINE_CONTACT_ADDRESS=
ROOTLINE_CONTACT_HOURS=
ROOTLINE_CONTACT_REPLY_TIME=
ROOTLINE_CONTACT_WHATSAPP_MESSAGE=
ROOTLINE_CONTACT_EMAIL_SUBJECT=
# Hours format, when you decide your schedule:
# Sat-Thu, 9:00 AM - 8:00 PM (Bangladesh time)
# Multiple shifts: Sat-Thu, 9:00 AM - 8:00 PM; Fri, 10:00 AM - 1:00 PM
# Other socials: a JSON array of {"label":"...","url":"https://..."}.

# Account recovery: console first; switch to the SMTP backend after testing.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=your-sender@gmail.com
EMAIL_HOST_PASSWORD=replace-with-your-gmail-app-password
DEFAULT_FROM_EMAIL=rootlineuap@gmail.com
STAFF_NOTIFICATION_EMAILS=owner@example.com,partner-reviewer@example.com
# Replace this placeholder with one generated secret; keep it stable on restarts.
DJANGO_SECRET_KEY=replace-with-a-locally-generated-secret
